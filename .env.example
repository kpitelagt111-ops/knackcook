# ──────────────────────────────────────────────────────────────
# KnackCook (affiliate-kk) — environment variables
# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# ──────────────────────────────────────────────────────────────

# App
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=https://knackcook.com

# Database (PostgreSQL)
DATABASE_URL="postgresql://knackcook:knackcook@localhost:5432/knackcook?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_MASTER_KEY="change-me-master-key"

# Auth.js (NextAuth v5)
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Canonical public URL — REQUIRED behind a reverse proxy (nginx/Cloudflare),
# otherwise post-login redirects target the container host (e.g. 0.0.0.0:3000).
# Set per environment: https://knackcook.com (prod), https://staging.knackcook.com (staging).
AUTH_URL=https://knackcook.com
AUTH_TRUST_HOST=true

# Ingestion API (n8n → site). Bearer token expected by /api/ingest/*
INGEST_API_KEY="change-me-strong-random-secret"

# Amazon affiliate (placeholders until the Associates account is approved — PR-1)
# One tag per marketplace. Configurable from the back office later.
AMAZON_TAG_US="knackcook-20"

# Creators API (Phase 7 — only once ≥10 sales / 30 days). Leave empty at launch.
CREATORS_API_ENABLED="false"
CREATORS_API_KEY=""

# Google Analytics (also editable from the back office Settings; lazy-loaded after consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Sentry (OPTIONAL — leave empty to fully disable Sentry. No DSN → complete no-op.)
# See docs/MONITORING.md. Tunnel route is /monitoring (configured in next.config.ts).
# Server/edge DSN (required to enable server-side capture).
SENTRY_DSN=
# Browser DSN (required to enable client-side capture).
NEXT_PUBLIC_SENTRY_DSN=
# Build-time auth token + org/project (required only to upload source maps).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Environment tag (e.g. "production", "staging"). Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Release identifier for source-map association (e.g. git short SHA, semver tag).
# Set in CI/CD before `pnpm build` to tag errors with the deployed release.
SENTRY_RELEASE=

# n8n manual sync trigger (back-office /admin/sync). Leave empty to disable.
N8N_SYNC_WEBHOOK_URL=

