# Staging environment template — copy to .env on VPS under /home/deploy/knackcook-staging/
# Use DIFFERENT secrets than prod. Generate fresh:
#   POSTGRES_PASSWORD=$(openssl rand -hex 24)
#   AUTH_SECRET=$(openssl rand -base64 32)
#   MEILISEARCH_MASTER_KEY=$(openssl rand -base64 32)
#   INGEST_API_KEY=$(openssl rand -base64 48)

NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://staging.knackcook.com

# Database (URL-safe hex password — see docs Bug #4)
DATABASE_URL="postgresql://knackcook:CHANGE_ME@postgres:5432/knackcook?schema=public"
POSTGRES_PASSWORD=CHANGE_ME

REDIS_URL="redis://redis:6379"
MEILISEARCH_HOST="http://meilisearch:7700"
MEILISEARCH_MASTER_KEY="CHANGE_ME"

# Auth.js v5 — must point to staging public URL
AUTH_SECRET="CHANGE_ME"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_URL=https://staging.knackcook.com
AUTH_TRUST_HOST=true

INGEST_API_KEY="CHANGE_ME"

# Amazon affiliate placeholder (staging uses same tag as prod for link-shape tests)
AMAZON_TAG_US="knackcook-20"
CREATORS_API_ENABLED="false"
CREATORS_API_KEY=""

# Analytics OFF on staging
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Sentry OFF on staging (or use a separate project)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=

N8N_SYNC_WEBHOOK_URL=
